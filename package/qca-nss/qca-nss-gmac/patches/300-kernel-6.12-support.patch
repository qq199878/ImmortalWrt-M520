 		ret = nss_gmac_tstamp_ioctl(netdev, ifr);
@@ -906,7 +906,7 @@ static const struct net_device_ops nss_gmac_netdev_ops = {
 	.ndo_set_mac_address = &nss_gmac_set_mac_address,
 	.ndo_validate_addr = &eth_validate_addr,
