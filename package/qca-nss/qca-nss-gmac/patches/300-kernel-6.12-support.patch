diff --git a/ipq806x/nss_gmac_ctrl.c b/ipq806x/nss_gmac_ctrl.c
index e5bcbf5..e7a904e 100644
--- a/ipq806x/nss_gmac_ctrl.c
+++ b/ipq806x/nss_gmac_ctrl.c
@@ -787,8 +787,8 @@ static uint32_t nss_gmac_tstamp_ioctl(struct net_device *netdev, struct ifreq *i
  * @param[in] ioctl command.
