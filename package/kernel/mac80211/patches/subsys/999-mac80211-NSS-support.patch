+#ifdef CPTCFG_MAC80211_NSS_SUPPORT
+#define MAC80211_NSS_CASE_STRING(value) case value: return #value
+
+static const char *mac80211_nss_tx_status_name(nss_tx_status_t status)
+{
+	switch (status) {
+		MAC80211_NSS_CASE_STRING(NSS_TX_SUCCESS);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_QUEUE);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_NOT_READY);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_TOO_LARGE);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_TOO_SHORT);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_NOT_SUPPORTED);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_BAD_PARAM);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_NOT_ENABLED);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_SYNC_BAD_PARAM);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_SYNC_TIMEOUT);
+		MAC80211_NSS_CASE_STRING(NSS_TX_FAILURE_SYNC_FW_ERR);
+	default:
+		return "Unknown NSS TX status";
+	}
+}
+
+static void mac80211_nss_rx_work(struct work_struct *work)
+{
+	struct ieee80211_sub_if_data *sdata =
+		container_of(work, struct ieee80211_sub_if_data, rx_work);
+	struct sk_buff *skb;
+
+	while ((skb = skb_dequeue(&sdata->rx_queue))) {
+		nss_tx_status_t status;
+
+		skb_push(skb, ETH_HLEN);
+		status = nss_virt_if_tx_buf(sdata->nssctx, skb);
+		if (unlikely(status != NSS_TX_SUCCESS)) {
+			if (net_ratelimit() && status != NSS_TX_FAILURE_TOO_SHORT)
+				sdata_err(sdata, "NSS TX failed: %s\n",
+					mac80211_nss_tx_status_name(status));
+			skb_pull(skb, ETH_HLEN);
+			netif_receive_skb(skb);
+		}
+	}
+
+	if (!skb_queue_empty(&sdata->rx_queue))
+		schedule_work(&sdata->rx_work);
+}
+
+static void mac80211_nss_receive(struct net_device *dev,
+					struct sk_buff *skb,
+					struct napi_struct *napi)
+{
+	struct ieee80211_sub_if_data *sdata;
+
+	if (!dev || !skb || !napi) {
+		kfree_skb(skb);
+		return;
+	}
+
+	sdata = netdev_priv(dev);
+	if (sdata->dev != dev) {
+		kfree_skb(skb);
+		return;
+	}
+
+	skb->dev = dev;
+	skb->protocol = eth_type_trans(skb, dev);
+	napi_gro_receive(napi, skb);
+}
+#endif
