--- a/ipq806x/nss_gmac_ctrl.c	2026-10-20 18:33:31.811208703 +0800
+++ b/ipq806x/nss_gmac_ctrl.c	2026-10-20 18:33:26.074961371 +0800
@@ -36,6 +36,7 @@
 #include <linux/platform_device.h>
