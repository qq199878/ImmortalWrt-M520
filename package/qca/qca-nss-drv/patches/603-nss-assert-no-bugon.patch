 #define nss_info_always(s, ...) pr_alert(s, ##__VA_ARGS__)
 
+/*
+ * 断言不 panic 版本
+ *
+ * 原实现在 NSS_DEBUG_LEVEL >= 1 时展开为 BUG_ON，驱动内有 102 处
+ * nss_assert（多为接口号校验）。在多核 + DSA 环境下接口号容易不匹配，
+ * 一旦断言失败即内核 panic 并无限重启，无法远程诊断。
+ *
+ * 改为只打印：断言失败时记录函数名、行号、表达式，然后继续执行。
+ * 这样既能拿到完整的失败上下文，又不会把设备变砖。
+ */
 #if (NSS_DEBUG_LEVEL < 1)
 #define nss_assert(fmt, args...)
 #else
-#define nss_assert(c) if (!(c)) { BUG_ON(!(c)); }
+#define nss_assert(c) do { \
+	if (unlikely(!(c))) { \
+		pr_err("NSS_ASSERT_FAILED %s[%d]: %s\n", __FUNCTION__, __LINE__, #c); \
+	} \
+} while (0)
 #endif
 
 #if defined(CONFIG_DYNAMIC_DEBUG)
