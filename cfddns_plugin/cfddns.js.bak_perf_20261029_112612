'use strict';
'require rpc';
'require dom';
'require ui';
'require view';

var callStatus = rpc.declare({
	object: 'luci.cfddns',
	method: 'status',
	expect: {}
});

var callProbe = rpc.declare({
	object: 'luci.cfddns',
	method: 'probe',
	expect: {}
});

var callRun = rpc.declare({
	object: 'luci.cfddns',
	method: 'run_now',
	expect: {}
});

var callSet = rpc.declare({
	object: 'luci.cfddns',
	method: 'set_interval',
	params: [ 'enabled', 'minutes' ],
	expect: {}
});

var callGetConfig = rpc.declare({
	object: 'luci.cfddns',
	method: 'get_config',
	expect: {}
});

var callSaveToken = rpc.declare({
	object: 'luci.cfddns',
	method: 'save_token',
	params: [ 'token' ],
	expect: {}
});

var callListZones = rpc.declare({
	object: 'luci.cfddns',
	method: 'list_zones',
	expect: {}
});

var callListRecords = rpc.declare({
	object: 'luci.cfddns',
	method: 'list_records',
	params: [ 'zone_id' ],
	expect: {}
});

var callAddRecord = rpc.declare({
	object: 'luci.cfddns',
	method: 'add_record',
	params: [ 'zone_id', 'zone_name', 'type', 'name', 'content', 'ttl', 'proxied', 'set_target' ],
	expect: {}
});

var callDelRecord = rpc.declare({
	object: 'luci.cfddns',
	method: 'del_record',
	params: [ 'zone_id', 'rec_id' ],
	expect: {}
});

var callSetTarget = rpc.declare({
	object: 'luci.cfddns',
	method: 'set_target',
	params: [ 'zone_id', 'zone_name', 'domain', 'record_type' ],
	expect: {}
});

