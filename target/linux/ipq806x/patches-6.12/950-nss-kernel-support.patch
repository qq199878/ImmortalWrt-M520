+	if (pch) {
+		spin_lock_bh(&pch->upl);
+		if (pch->ppp && pch->ppp->dev)
+			ifindex = pch->ppp->dev->ifindex;
+		spin_unlock_bh(&pch->upl);
+	}
+	return ifindex;
+}
