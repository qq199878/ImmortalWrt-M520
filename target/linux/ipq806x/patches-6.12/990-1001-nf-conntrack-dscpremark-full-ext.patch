+/* SPDX-License-Identifier: ISC */
+/*
+ * nf_conntrack_dscpremark_ext.h - conntrack extension for DSCP remark
+ *
+ * Backport of the QSDK private conntrack extension used by the QCA NSS
+ * ECM (Enhanced Connection Manager) DSCP classifier.
+ *
+ * The extension carries the per-direction QoS priority and DSCP value of a
+ * connection so that the NSS hardware offload path can preserve the DSCP
+ * marking that was applied in software by the iptables DSCP target.
+ */
+#ifndef _NF_CONNTRACK_DSCPREMARK_EXT_H
+#define _NF_CONNTRACK_DSCPREMARK_EXT_H
+
+#include <linux/types.h>
+#include <linux/skbuff.h>
+#include <net/netfilter/nf_conntrack.h>
+#include <net/netfilter/nf_conntrack_extend.h>
+
+/*
+ * Validity of the DSCP remark rule for a connection.
+ */
+enum nf_ct_dscpremark_ext_rule_validity {
+	NF_CT_DSCPREMARK_EXT_RULE_INVALID = 0,
+	NF_CT_DSCPREMARK_EXT_RULE_VALID = 1,
+};
+
+/*
+ * Which QoS features are recorded in flow_set_flags / return_set_flags.
+ */
+#define NF_CT_DSCPREMARK_EXT_PRIO 0x1
+#define NF_CT_DSCPREMARK_EXT_DSCP 0x2
+#define NF_CT_DSCPREMARK_EXT_IGS_QOS 0x4
+#define NF_CT_DSCPREMARK_EXT_MARK 0x8
+#define NF_CT_DSCPREMARK_EXT_SAWF 0x10
+
+/*
+ * Per-connection DSCP remark extension.
+ *
+ * flow_*  : direction from the connection originator to the responder
+ * reply_* : direction from the responder back to the originator
+ *
+ * priority mirrors skb->priority (the QoS mark), dscp is the 6 bit DSCP
+ * value extracted from the IP header.
+ */
+struct nf_ct_dscpremark_ext {
+	u32 flow_priority;
+	u32 reply_priority;
+	u32 flow_mark;
+	u32 reply_mark;
+	u32 flow_sawf_meta;
+	u32 return_sawf_meta;
+	u16 igs_flow_qos_tag;
+	u16 igs_reply_qos_tag;
+	u8 flow_dscp;
+	u8 reply_dscp;
+	u8 rule_valid;
+	u16 flow_set_flags;
+	u16 return_set_flags;
+};
+
+#ifdef CONFIG_NF_CONNTRACK_DSCPREMARK_EXT
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_find(const struct nf_conn *ct)
+{
+	return nf_ct_ext_find(ct, NF_CT_EXT_DSCPREMARK);
+}
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_add(struct nf_conn *ct, gfp_t gfp)
+{
+	struct nf_ct_dscpremark_ext *dscpcte;
+
+	dscpcte = nf_ct_ext_add(ct, NF_CT_EXT_DSCPREMARK, gfp);
+	return dscpcte;
+}
+
+extern int
+nf_conntrack_dscpremark_ext_get_dscp_rule_validity(const struct nf_conn *ct);
+
+extern void
+nf_conntrack_dscpremark_ext_set_dscp_rule_validity(struct nf_conn *ct, int valid);
+
+#else /* !CONFIG_NF_CONNTRACK_DSCPREMARK_EXT */
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_find(const struct nf_conn *ct)
+{
+	return NULL;
+}
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_add(struct nf_conn *ct, gfp_t gfp)
+{
+	return NULL;
+}
+
+static inline int
+nf_conntrack_dscpremark_ext_get_dscp_rule_validity(const struct nf_conn *ct)
+{
+	return NF_CT_DSCPREMARK_EXT_RULE_INVALID;
+}
+
+static inline void
+nf_conntrack_dscpremark_ext_set_dscp_rule_validity(struct nf_conn *ct, int valid)
+{
+}
+
+#endif /* CONFIG_NF_CONNTRACK_DSCPREMARK_EXT */
+
+#endif /* _NF_CONNTRACK_DSCPREMARK_EXT_H */
--- /dev/null
+++ b/net/netfilter/nf_conntrack_dscpremark_ext.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: ISC
+/*
+ * nf_conntrack_dscpremark_ext.c - conntrack extension for DSCP remark
+ *
+ * Backport of the QSDK private conntrack extension consumed by the QCA NSS
+ * ECM DSCP classifier.
+ *
+ * The extension is attached to a conntrack entry when the iptables DSCP
+ * target marks a flow. The NSS ECM classifier reads it back and programs
+ * the hardware offload path so the DSCP marking survives acceleration.
+ */
+#include <linux/skbuff.h>
+#include <linux/types.h>
+#include <net/netfilter/nf_conntrack.h>
+#include <net/netfilter/nf_conntrack_extend.h>
+#include <net/netfilter/nf_conntrack_dscpremark_ext.h>
+
+/*
+ * nf_conntrack_dscpremark_ext_get_dscp_rule_validity()
+ *	Return whether a DSCP remark rule is valid for this connection.
+ */
+int nf_conntrack_dscpremark_ext_get_dscp_rule_validity(const struct nf_conn *ct)
+{
+	struct nf_ct_dscpremark_ext *dscpcte;
+
+	if (!ct)
+		return NF_CT_DSCPREMARK_EXT_RULE_INVALID;
+
+	dscpcte = nf_ct_dscpremark_ext_find(ct);
+	if (!dscpcte)
+		return NF_CT_DSCPREMARK_EXT_RULE_INVALID;
+
+	return dscpcte->rule_valid ? NF_CT_DSCPREMARK_EXT_RULE_VALID :
+				     NF_CT_DSCPREMARK_EXT_RULE_INVALID;
+}
+EXPORT_SYMBOL_GPL(nf_conntrack_dscpremark_ext_get_dscp_rule_validity);
+
+/*
+ * nf_conntrack_dscpremark_ext_set_dscp_rule_validity()
+ *	Mark the DSCP remark rule of this connection as valid or not.
+ */
+void nf_conntrack_dscpremark_ext_set_dscp_rule_validity(struct nf_conn *ct, int valid)
+{
+	struct nf_ct_dscpremark_ext *dscpcte;
+
+	if (!ct)
+		return;
+
+	dscpcte = nf_ct_dscpremark_ext_find(ct);
+	if (!dscpcte)
+		return;
+
+	dscpcte->rule_valid = valid ? 1 : 0;
+}
+EXPORT_SYMBOL_GPL(nf_conntrack_dscpremark_ext_set_dscp_rule_validity);
+
+/*
+ * This file is linked into the nf_conntrack.o composite module, so it must
+ * not declare its own module_init/module_exit entry points.
+ */
