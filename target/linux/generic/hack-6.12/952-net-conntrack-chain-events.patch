+/*
+ * Record the DSCP marking of this connection into the conntrack
+ * DSCPREMARK extension so that the QCA NSS ECM DSCP classifier can
+ * preserve it across hardware acceleration.
+ */
+static void dscp_tg_ct_record(struct sk_buff *skb, u_int8_t dscp)
+{
+#ifdef CONFIG_NF_CONNTRACK_DSCPREMARK_EXT
+	struct nf_ct_dscpremark_ext *dscpcte;
+	enum ip_conntrack_info ctinfo;
+	struct nf_conn *ct;
+	bool src;
+
+	ct = nf_ct_get(skb, &ctinfo);
+	if (!ct)
+		return;
+
+	dscpcte = nf_ct_dscpremark_ext_find(ct);
+	if (!dscpcte) {
+		dscpcte = nf_ct_dscpremark_ext_add(ct, GFP_ATOMIC);
+		if (!dscpcte)
+			return;
+	}
+
+	src = (ctinfo == IP_CT_NEW || ctinfo == IP_CT_RELATED ||
+	       ctinfo == IP_CT_RELATED_REPLY ||
+	       (ctinfo & IP_CT_IS_REPLY) == 0);
+
+	if (src) {
+		dscpcte->flow_dscp = dscp;
+		dscpcte->flow_priority = skb->priority;
+	} else {
+		dscpcte->reply_dscp = dscp;
+		dscpcte->reply_priority = skb->priority;
+	}
+
+	dscpcte->rule_valid = 1;
+#endif
+}
