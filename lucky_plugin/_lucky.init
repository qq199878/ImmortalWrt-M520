#!/bin/sh /etc/rc.common
# Lucky 内网穿透服务（procd 托管）
# 作者：海鸥

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/lucky
CONF_DIR=/etc/lucky
HTTP_PORT=16603
HTTPS_PORT=16601

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -cd "$CONF_DIR" -port "$HTTP_PORT"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_set_param file "$CONF_DIR"
	procd_close_instance
}

stop_service() {
	# procd 会自动发 SIGTERM，这里只做收尾清理
	logger -t lucky "stopping"
}

service_triggers() {
	procd_add_reload_trigger "lucky"
}