#!/bin/sh /etc/rc.common
# ubusd 健康守护
# 开机时检查 ubus socket 是否可用，不可用则重建
# 启动序号 11，早于 rpcd 的 12

START=11
STOP=05

SOCK=/var/run/ubus/ubus.sock

start() {
	# 1) socket 存在但连不通 = 孤立文件，删掉重建
	if [ -S "$SOCK" ] && ! ubus list >/dev/null 2>&1; then
		logger -t ubus-guard "socket 孤立，重建"
		rm -f "$SOCK"
	fi

	# 2) ubusd 不在跑就启动
	if ! pidof ubusd >/dev/null 2>&1; then
		logger -t ubus-guard "ubusd 未运行，启动"
		/sbin/ubusd -s "$SOCK" &
		sleep 1
	fi

	# 3) 等就绪
	i=0
	while [ $i -lt 10 ]; do
		ubus list >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	if ubus list >/dev/null 2>&1; then
		logger -t ubus-guard "ubus 就绪"
		return 0
	fi
	logger -t ubus-guard "ubus 仍未就绪"
	return 1
}

stop() {
	:
}

reload() {
	start
}